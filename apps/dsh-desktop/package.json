{
  "name": "@harness-design/desktop",
  "version": "0.1.29",
  "private": true,
  "description": "Desktop learning and working environment for DeepSeek Harness with isolated official-core updates",
  "author": "jerry-yu95 and contributors",
  "homepage": "https://github.com/jerry-yu95/deepseek-harness-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerry-yu95/deepseek-harness-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/jerry-yu95/deepseek-harness-desktop/issues"
  },
  "type": "module",
  "main": "src/main.mjs",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "electron src/main.mjs",
    "capture:startup": "node scripts/capture-startup.mjs",
    "capture:extensions": "node scripts/capture-startup.mjs --extensions",
    "test:window-chrome:e2e": "node scripts/verify-window-chrome.mjs",
    "test:directory-picker:e2e": "node scripts/verify-directory-picker.mjs",
    "test:adaptive-theme:e2e": "node scripts/verify-adaptive-theme.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dir": "electron-builder --dir",
    "pack:verify": "node scripts/verify-package.mjs \"dist/win-unpacked/resources\" win32 x64",
    "pack:verify:mac:arm64": "node scripts/verify-package.mjs \"dist/mac-arm64/Harness Design Desktop.app/Contents/Resources\" darwin arm64",
    "pack:verify:mac:x64": "node scripts/verify-package.mjs \"dist/mac/Harness Design Desktop.app/Contents/Resources\" darwin x64",
    "pack:win": "electron-builder --win nsis --publish never",
    "pack:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "pack:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish never",
    "pack:mac:x64": "electron-builder --mac dmg zip --x64 --publish never"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-win32-x64": "0.35.3",
    "@koromix/koffi-darwin-arm64": "3.1.4",
    "@koromix/koffi-darwin-x64": "3.1.4",
    "@koromix/koffi-win32-x64": "3.1.4",
    "@linxin666/dsh-web-ui-all": "workspace:*",
    "@xmanrui/dsh-im": "0.13.0",
    "electron-updater": "6.6.2",
    "koffi": "3.1.4",
    "pnpm": "11.21.0",
    "sharp": "0.35.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  }
}
