{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "composite": true, "rootDir": "src", "outDir": "lib/types",
    "declaration": true, "declarationMap": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
