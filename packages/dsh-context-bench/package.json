{
  "name": "@harness-design/dsh-context-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic and opt-in live benchmarks for DeepSeek Harness long-context compaction quality.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "bench:deterministic": "node --experimental-strip-types src/cli.ts --tier deterministic",
    "bench:live": "node --experimental-strip-types src/cli.ts --tier live"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.8"
  },
  "license": "BSD-3-Clause"
}
