{
  "name": "deepseek-harness-desktop-workspace",
  "version": "0.1.24",
  "private": true,
  "description": "Cross-platform community desktop application and extension workspace for DeepSeek Harness.",
  "author": "jerry-yu95 and contributors",
  "homepage": "https://github.com/jerry-yu95/deepseek-harness-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerry-yu95/deepseek-harness-desktop.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --filter @harness-design/desktop dev",
    "desktop:test": "pnpm --filter @harness-design/desktop test",
    "desktop:pack": "pnpm --filter @harness-design/desktop pack:win",
    "desktop:pack:mac": "pnpm --filter @harness-design/desktop pack:mac",
    "aggregate:check": "node scripts/aggregate.mjs --check",
    "gallery:check": "node scripts/gallery-build --check",
    "skin-center:check": "node scripts/skin-center-bundles --check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "skin:new": "node scripts/dsh-skin-new",
    "gallery:build": "node scripts/gallery-build",
    "gallery:capture": "node scripts/capture-previews"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.2"
  }
}
